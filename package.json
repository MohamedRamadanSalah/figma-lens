{
  "name": "figma-lens",
  "version": "0.1.0",
  "description": "Let Claude Code see Figma designs accurately without the Figma MCP or Dev Mode: a Figma plugin + local bridge that exports layout specs, tokens, screenshots and icons.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit -p . && esbuild plugin/src/code.ts --bundle --format=iife --target=es2017 --outfile=plugin/dist/code.js",
    "watch": "esbuild plugin/src/code.ts --bundle --format=iife --target=es2017 --outfile=plugin/dist/code.js --watch",
    "typecheck": "tsc --noEmit -p .",
    "bridge": "node bridge/server.js",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
